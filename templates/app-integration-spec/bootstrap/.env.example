# Authway SSO Integration — .env template
# Copy to .env and fill values. NEVER commit .env to git (already in .gitignore).
#
# Cấp bởi admin sau khi đăng ký app trên Central RBAC portal:

# Base URL Zitadel (LAN: http://10.200.0.125 / Prod: https://auth.inet.vn)
OIDC_ISSUER=

# Numeric snowflake, VD 387047455193104387
CLIENT_ID=

# Basic auth apps only. BỎ NẾU SPA browser PKCE (public client).
CLIENT_SECRET=

# EXACT match với Zitadel Console. Path tuỳ framework:
#   - Pattern A oauth2-proxy: https://<APP_HOST>/oauth2/callback
#   - Next.js Auth.js:        https://<APP_HOST>/api/auth/callback/zitadel
#   - SPA oidc-client-ts:     https://<APP_HOST>/callback
#   - Framework khác:         theo library docs
REDIRECT_URL=

# Nơi user land sau end_session, thường app root
POST_LOGOUT_URL=

# ─── App-specific (member tự set) ───

# Public hostname app, VD myapp.example.com (không có https://)
APP_HOST=

# Port app native listen (127.0.0.1:<APP_PORT>)
APP_PORT=3000

# ─── Pattern A only (oauth2-proxy sidecar) ───

# Generate: openssl rand -base64 32
COOKIE_SECRET=
