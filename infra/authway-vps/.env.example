# authway-vps prod environment variables
# Copy to .env and fill values before deploying.
# NEVER commit .env to git.
#
# Generate secure values:
#   Password/key:  openssl rand -base64 32
#   Masterkey:     openssl rand -hex 16   (must be exactly 32 hex chars = 16 bytes)

# --- Postgres ---
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=<openssl rand -base64 32>

ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=<openssl rand -base64 32>

# --- Zitadel ---
# Must be exactly 32 hex characters (openssl rand -hex 16)
ZITADEL_MASTERKEY=<openssl rand -hex 16>

# External domain — IP-as-domain for pilot (no DNS)
ZITADEL_EXTERNAL_DOMAIN=10.200.0.125

# Admin account created during setup (write down — shown only once)
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=<openssl rand -base64 24>
